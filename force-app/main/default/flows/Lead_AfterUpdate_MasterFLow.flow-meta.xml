<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Check_if_Automation_is_disabled_for_user</name>
        <label>Check if Automation is disabled for user</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Generic_field_on_lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isDisabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Flow_disable_ckeck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>isDisabled</label>
        </rules>
    </decisions>
    <description>This masterflow runs all the subflows for lead</description>
    <environments>Default</environments>
    <formulas>
        <name>Flow_disable_ckeck</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Autolaunch_Lightning_Flow__c}</expression>
    </formulas>
    <formulas>
        <name>isChanged_NotAtCompany</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Not_at_Company_Flag__c})</expression>
    </formulas>
    <interviewLabel>Lead_AfterUpdate_MasterFLow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_AfterUpdate_MasterFLow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Automation_is_disabled_for_user</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Update_Generic_field_on_lead</name>
        <label>Update Generic field on lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Lead_AL_UpdateGenericFields</flowName>
        <inputAssignments>
            <name>NotAtCompany_isChanged</name>
            <value>
                <elementReference>isChanged_NotAtCompany</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
