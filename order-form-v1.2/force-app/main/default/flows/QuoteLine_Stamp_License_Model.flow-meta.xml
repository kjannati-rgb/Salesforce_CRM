<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Assign_Limited_Access</name>
        <label>US-sold: Limited Access, count = seats</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.License_Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Limited Access</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Authorised_User_Count__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Number_of_Seats__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Benefiting_Group</name>
        <label>EMEA/APAC-sold: Benefiting Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.License_Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Benefiting Group</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Product_Default</name>
        <label>Model from the product rules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.License_Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ProductDefaultModel</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Count_From_Quantity</name>
        <label>Count = quantity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Authorised_User_Count__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SBQQ__Quantity__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_From_Override</name>
        <label>Model from the manual override</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.License_Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.License_Model_Override__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Count</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Override</name>
        <label>Manual override set?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_Family</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No override - derive</defaultConnectorLabel>
        <rules>
            <name>Override_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.License_Model_Override__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_From_Override</targetReference>
            </connector>
            <label>Override set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Family</name>
        <label>Which rule set?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Product_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Product rules</defaultConnectorLabel>
        <rules>
            <name>Lawcom_Family</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsLawcomFamily</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Region</targetReference>
            </connector>
            <label>Law.com family (region rule)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Region</name>
        <label>Sold out of the USA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Benefiting_Group</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>EMEA / APAC (or unknown)</defaultConnectorLabel>
        <rules>
            <name>US_Entity</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>LineBillingEntity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ALM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LineBillingEntity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LLC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Limited_Access</targetReference>
            </connector>
            <label>US entity (ALM / LLC)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Count</name>
        <label>Count derivable from quantity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No derived count</defaultConnectorLabel>
        <rules>
            <name>Quantity_Count</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.License_Model__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Authorised Users</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.License_Model__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Limited Access</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Count_From_Quantity</targetReference>
            </connector>
            <label>Authorised Users / Limited Access (non-Law.com)</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsLawcomFamily</name>
        <dataType>Boolean</dataType>
        <expression>OR(TEXT({!$Record.SBQQ__Product__r.Family}) = &quot;Subs - Law.com&quot;, TEXT({!$Record.SBQQ__Product__r.Family}) = &quot;Subs - Law Journal Press&quot;, TEXT({!$Record.SBQQ__Product__r.Family}) = &quot;Subs - Regional&quot;)</expression>
    </formulas>
    <formulas>
        <name>LineBillingEntity</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.SBQQ__Quote__r.SBQQ__Opportunity2__r.Billing_Entity__c})</expression>
    </formulas>
    <formulas>
        <name>ProductDefaultModel</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.SBQQ__Product__r.License_Model__c})</expression>
    </formulas>
    <interviewLabel>Quote Line - Stamp License Model {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line - Stamp License Model</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Override</targetReference>
        </connector>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
