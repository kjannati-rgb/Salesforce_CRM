    </formulas>
    <formulas>
        <name>var_checkforAccountchange</name>
        <dataType>Boolean</dataType>
        <expression>AND (OR( ISNEW(), ISCHANGED({!$Record.AccountId}  )), 
NOT(ISBLANK({!$Record.Account.Ultimate_Account__c}  )))</expression>
    </formulas>
    <formulas>
        <name>var_checkfornewcontract</name>
