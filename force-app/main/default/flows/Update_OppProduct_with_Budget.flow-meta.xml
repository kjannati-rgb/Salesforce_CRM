    <decisions>
        <name>Is_there_a_Budget_Record</name>
        <label>Is there a Budget Record?</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Budget_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_the_Budget.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Budget_to_Opportunity_Product</targetReference>
            </connector>
            <label>Yes - Budget Found</label>
        </rules>
        <rules>
            <name>No_Budget_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_the_Budget.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Budget</targetReference>
            </connector>
            <label>No - Budget Not Found</label>
        </rules>
    </decisions>
