    <decisions>
        <name>Decision_Has_Lines</name>
        <label>Quote has lines? (skip the line query otherwise)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_API_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No lines - skip query</defaultConnectorLabel>
        <rules>
            <name>Has_Lines</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__LineItemCount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_API_Line</targetReference>
            </connector>
            <label>Has lines</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Terms_Config_Match</name>
        <label>Does this terms config apply?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Configs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No match</defaultConnectorLabel>
        <rules>
            <name>Terms_Role_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Configs.Role_Pattern__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OwnerRoleName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Configs.Role_Pattern__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Terms_From_Config</targetReference>
            </connector>
            <label>Owner role matches pattern</label>
        </rules>
        <rules>
            <name>Terms_Default_And_Unmatched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Configs.Is_Default__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TermsMatched</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Terms_Default</targetReference>
            </connector>
            <label>Default (nothing matched yet)</label>
        </rules>
    </decisions>
