    <description>This flow replaces the Opportunity Product Process Builder with updated functionality specifically focused on Budgets</description>
    <environments>Default</environments>
    <formulas>
        <name>checkdisabledprocess</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Process_Builders__c}</expression>
    </formulas>
    <formulas>
        <name>DisableAutoLaunchFlow</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Autolaunch_Lightning_Flow__c}</expression>
    </formulas>
    <formulas>
        <name>OnCreate_Edit</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>PrimaryContactCheck</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISNEW(),ISCHANGED({!$Record}.Opportunity.Primary_Contact__c ) = TRUE )</expression>
    </formulas>
    <formulas>
        <name>ReportingStreamChange</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED( {!$Record}.Product2.Reporting_Stream__c) = TRUE</expression>
    </formulas>
