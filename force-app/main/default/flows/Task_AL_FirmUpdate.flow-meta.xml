    <description>Flow stamps firm Account on the task. Prioritising Contact then Opportunity then Account</description>
    <environments>Default</environments>
    <formulas>
        <name>check_whatid</name>
        <dataType>String</dataType>
        <expression>if(left({!$Record.WhatId},3)==&apos;006&apos;,&apos;Opportunity&apos;,
if(left({!$Record.WhatId},3)==&apos;001&apos;,&apos;Account&apos;,&apos;&apos;
))</expression>
    </formulas>
    <formulas>
        <name>check_whoid</name>
        <dataType>String</dataType>
        <expression>if(left({!$Record.WhoId},3)==&apos;003&apos;,&apos;Contact&apos;,&apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>CheckAutomationDisabled</name>
