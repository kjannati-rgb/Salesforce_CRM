<messaging:emailTemplate subject="{!relatedTo.Quote__r.Name} has been Approved!" recipientType="User"
    relatedToType="sbaa__Approval__c">
    <messaging:htmlEmailBody >
        <html>

        <body>
            <table style="border-collapse:collapse; width:70%;">
                <tbody>
                    <tr>
                        <td align="center" style="padding:24px 12px;font-family:'Helvetica Neue',Arial,sans-serif">
                            <table role="presentation" width="600" cellpadding="0" cellspacing="0" align="center"
                                style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e1e0d9;border-collapse:separate;mso-table-lspace:0;mso-table-rspace:0;font-family:'Helvetica Neue',Arial,sans-serif;color:#003340">

                                <tr>
                                    <td
                                        style="background:#003340;padding:30px 40px 24px;text-align:center;font-family:'Helvetica Neue',Arial,sans-serif">
                                        <div
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:bold;font-size:28px;line-height:1;letter-spacing:.14em;color:#ffffff">
                                            CE<span style="color:#00c8a7">N</span>TELLIC</div>
                                        <div
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:9px;font-size:11px;letter-spacing:.32em;color:#80ffff;text-transform:uppercase">
                                            Intelligence &amp; information services</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:4px;background:#00c8a7;font-size:0;line-height:0">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="padding:25px 30px 10px 30px;">
                                        <h3 style="color:#008f96;">Management has approved your approval request for
                                            Quote: {!relatedTo.Quote__r.Name}</h3>
                                        <h4>Approval Notes: {!relatedTo.sbaa__CommentsLong__c}</h4>

                                        <p>
                                            Click <a
                                                href="{!relatedTo.Quote__r.BaseUrl__c}{!relatedTo.Quote__c}">here</a>
                                            to
                                            view
                                            the Quote.</p>
                                    </td>
                                </tr>

                                <tr>
                                    <td
                                        style="background:#ffffff;padding:22px 40px 6px;font-family:'Helvetica Neue',Arial,sans-serif">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                            style="border-collapse:separate">
                                            <tr>
                                                <td width="33%" valign="top" style="padding:6px">
                                                    <div
                                                        style="background:#e8f6f2;border-radius:12px;padding:16px 10px;text-align:center">
                                                        <div
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.08em;color:#008ca6;text-transform:uppercase">
                                                            Amount</div>
                                                        <div
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:6px;font-weight:bold;font-size:18px;line-height:1.2;color:#003340">
                                                            {!relatedTo.Quote__r.CurrencyIsoCode}
                                                            {!relatedTo.Quote__r.SBQQ__NetAmount__c}</div>
                                                    </div>
                                                </td>

                                                <td width="33%" valign="top" style="padding:6px">
                                                    <div
                                                        style="background:#e8f6f2;border-radius:12px;padding:16px 10px;text-align:center">
                                                        <div
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.08em;color:#008ca6;text-transform:uppercase">
                                                            Avg Discount</div>
                                                        <div
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:6px;font-weight:bold;font-size:18px;line-height:1.2;color:#003340">
                                                            <apex:outputText value="{0, number}">
                                                                <apex:param value="{!relatedTo.Quote__r.SBQQ__AverageCustomerDiscount__c}" />
                                                            </apex:outputText>%
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td
                                        style="background:#ffffff;padding:5px 24px 4px;font-family:'Helvetica Neue',Arial,sans-serif">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px">
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Account</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.SBQQ__Account__r.name}</td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Date Requested</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    <apex:outputText value="{0,date,d / M / y }">
                                                        <apex:param value="{!relatedTo.Quote__r.SubmittedDate__c}" />
                                                    </apex:outputText>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Opportunity</td>
                                                <td
                                                    style=" font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    <a
                                                        href="{!relatedTo.Quote__r.BaseUrl__c}{!relatedTo.Quote__r.SBQQ__Opportunity2__r.Id}">{!relatedTo.Quote__r.SBQQ__Opportunity2__r.Name}</a>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Special Terms Identified</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Special_Terms_Identified__c}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Special Instructions</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Special_Instructions__c}</td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Auto-Renewal removed</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Auto_renewal_removed__c}
                                                </td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Renewal Terms Justification</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Renewal_Terms_Justification__c}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Discount Reason</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Discount_reasons__c}</td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Other Discount Reason</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Other_discount_reasons__c}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Reason</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.sbaa__Rule__r.Name}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Billing Frequency</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.SBQQ__BillingFrequency__c}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Payment Terms</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.SBQQ__PaymentTerms__c}
                                                </td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">
                                                    Payment Type</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.Quote__r.Payment_Type__c}</td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Renewal Uplift</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    <p>
                                                        <apex:outputText value="{0, number}">
                                                            <apex:param value="{!relatedTo.Quote__r.Renewal_Uplift__c}" />
                                                        </apex:outputText>%
                                                    </p>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">
                                                    Approval Status</td>
                                                <td
                                                    style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;border-bottom:1px solid #efeee8;text-align:left">
                                                    {!relatedTo.sbaa__Status__c}
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td
                                        style="background:#003340;padding:26px 40px;font-family:'Helvetica Neue',Arial,sans-serif">
                                        <div
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:bold;font-size:18px;line-height:1;letter-spacing:.12em;color:#ffffff">
                                            CE<span style="color:#00c8a7">N</span>TELLIC</div>
                                        <div
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:10px;font-size:12px;line-height:1.6;color:#9fc7c6">
                                            Global intelligence and information services, setting the standard for how
                                            critical business decisions are made.</div>
                                        <div
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:14px;padding-top:14px;border-top:1px solid #0c4a55;font-size:11px;line-height:1.6;color:#6f9a9b">
                                            Sent automatically from Salesforce.</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
            <p></p>
        </body>

        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>