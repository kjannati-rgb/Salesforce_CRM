    </formulas>
    <formulas>
        <name>AMEmailPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__SalesRep__c}), "", {!$Record.SBQQ__SalesRep__r.Email} &amp; IF(ISBLANK({!$Record.SBQQ__SalesRep__r.Phone}), "", " / " &amp; {!$Record.SBQQ__SalesRep__r.Phone}))</expression>
