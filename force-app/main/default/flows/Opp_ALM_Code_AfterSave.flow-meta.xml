        <name>frm_ProductKey</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!Loop_Classify.Product2Id}) &amp; ";"</expression>
    </formulas>
    <formulas>
        <name>frm_IsNewProduct</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!vProductIds}, CASESAFEID({!Loop_Classify.Product2Id})))</expression>
    </formulas>
    <formulas>
        <name>frm_LineCodeKey</name>
        <dataType>String</dataType>
        <expression>";" &amp; {!Loop_Classify.ProductCode} &amp; ";"</expression>
    </formulas>
    <formulas>
        <name>frm_IsFam1</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Loop_Classify.ProductCode})), CONTAINS({!vFam1Anchors}, {!frm_LineCodeKey}))</expression>
    </formulas>
    <formulas>
        <name>frm_IsFam2</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Loop_Classify.ProductCode})), CONTAINS({!vFam2Anchors}, {!frm_LineCodeKey}))</expression>
    </formulas>
    <formulas>
        <name>frm_IsFam3</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Loop_Classify.ProductCode})), CONTAINS({!vFam3Anchors}, {!frm_LineCodeKey}))</expression>
    </formulas>
    <formulas>
        <name>frm_LineAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!vUseNet}, BLANKVALUE({!Loop_Classify.TotalPrice}, 0), BLANKVALUE({!Loop_Classify.ListPrice}, 0) * BLANKVALUE({!Loop_Classify.Quantity}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frm_VARCode</name>
        <dataType>Number</dataType>
        <expression>IF({!vFam1Total} &gt;= {!vFam3Total}, {!vFam1Code}, {!vFam3Code})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_IsExistingCode</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Loop_Stamp.Full_Contract_Value__c})), OR({!Loop_Stamp.Full_Contract_Value__c} = {!vFam1Code}, {!Loop_Stamp.Full_Contract_Value__c} = {!vFam2Code}, {!Loop_Stamp.Full_Contract_Value__c} = {!vFam3Code}))</expression>
    </formulas>
    <formulas>
        <name>frm_NoAnchorMsg</name>
        <dataType>String</dataType>
        <expression>"REV-71: opportunity " &amp; {!$Record.Id} &amp; " has " &amp; TEXT({!vDistinctCount}) &amp; " distinct standalone products but no anchor product (no bundle family mapped). No code stamped; stale codes cleared. By design per spec §4/§8-Q2 — logged for visibility."</expression>
    </formulas>
    <formulas>
        <name>frm_FaultDetails</name>
        <dataType>String</dataType>
        <expression>"REV-71 Opp_ALM_Code_AfterSave fault on opportunity " &amp; {!$Record.Id} &amp; ": " &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
