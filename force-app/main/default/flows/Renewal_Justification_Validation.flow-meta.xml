    <decisions>
        <name>Check_for_Renewal_Uplift_and_Auto_renewal_removed</name>
        <label>Check for Renewal Uplift and Auto renewal removed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <rules>
            <name>Renewal_Uplift_AND_Auto_renewal_removed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Renewal_Uplift__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>7.5</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Auto_renewal_removed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_special_terms_and_justification</targetReference>
            </connector>
            <label>Renewal Uplift AND Auto renewal removed</label>
        </rules>
        <rules>
            <name>Renewal_Uplift_removed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Renewal_Uplift__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>7.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_special_terms_and_justification_Renewal_Uplift</targetReference>
            </connector>
            <label>Renewal Uplift removed</label>
        </rules>
        <rules>
            <name>Auto_renewal_removed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Auto_renewal_removed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_special_terms_and_justification_Auto_Renewal_removed</targetReference>
            </connector>
            <label>Auto renewal removed</label>
        </rules>
    </decisions>
