    <description>Migrated from the Contact Object - Create/Edit process using multiple criteria.
Runs upon Contact records being created and edited</description>
    <environments>Default</environments>
    <formulas>
        <name>var_checkforaccount</name>
        <dataType>Boolean</dataType>
        <expression>AND (OR( ISNEW(), ISCHANGED({!$Record.AccountId} )), 
NOT(ISBLANK({!$Record.Account.Ultimate_Account__c})))</expression>
    </formulas>
    <formulas>
        <name>var_city</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.MailingCity} ), {!$Record.Account.BillingCity} , {!$Record.MailingCity})</expression>
    </formulas>
    <formulas>
        <name>var_country</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.MailingCountry} ), {!$Record.Account.BillingCountry} , {!$Record.MailingCountry})</expression>
    </formulas>
    <formulas>
        <name>var_emailpriorvalue</name>
        <dataType>String</dataType>
        <expression>PRIORVALUE({!$Record.Email})</expression>
    </formulas>
    <formulas>
        <name>var_phone</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.Phone}), {!$Record.Account.Phone} , {!$Record.Phone})</expression>
    </formulas>
    <formulas>
        <name>var_postcode</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.MailingPostalCode} ), {!$Record.Account.BillingPostalCode} , {!$Record.MailingPostalCode})</expression>
    </formulas>
    <formulas>
        <name>var_processdisabled</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Process_Builders__c}</expression>
    </formulas>
    <formulas>
        <name>var_state</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.MailingState} ), {!$Record.Account.BillingState}, {!$Record.MailingState})</expression>
    </formulas>
    <formulas>
        <name>var_street</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!$Record.MailingStreet} ), {!$Record.Account.BillingStreet} , {!$Record.MailingStreet})</expression>
    </formulas>
