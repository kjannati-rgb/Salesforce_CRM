<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Form_PO_Req_No_Tag__c</fullName>
    <description>Adobe required radio tag (value No) for the PO-required signer question - emitted only when PO_Number__c is blank.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(PO_Number__c), "{{*PO_Required_es_:signer1:radio(No)}}", "")</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Order Form PO Required No Tag</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
