<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>Managers</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Legal_Careers_Group_Senior_Account_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>MBL_Seminars_Customer_Success_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>MBL_Seminars_Senior_Key_Account_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>PI_Commercial_Director_GXRs_and_Specialist_Platforms</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StageName</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>bernadette.osullivan@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>chloe.orrin@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>kevin.daud@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>leslie.perry@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>ravindraanandrao.chavan@alm.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Finance Approval</label>
        <name>Finance_Approval</name>
    </approvalStep>
    <emailTemplate>SA_Opportunity_Email_Templates/Opportunity_Approval_Process</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(NOT( $Setup.Application_Settings__c.Disable_Approval_Processes__c ),
NOT(Approved__c),
NOT(Submitted_to_Approval_Process__c),
ISPICKVAL( StageName , &apos;Closed won – pending approval&apos;)
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Finance_Submitted_to_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Approved_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Ordered</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stage_Closed_Won</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opportunity_Approved_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Rejection_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Rejected_Submitted_to_Approval_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stage_Contract_Out</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Finance Approval Process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Opportunity_Recall_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Recall_Opportunity_Approved_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recall_Stage_Contract_Out</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recall_Submitted_for_Approval_False</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
