<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <actionCalls>
        <name>Act_StampOpp</name>
        <label>Stamp ALM Promo/Dispatch (Layer 2)</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>ALMPromoDispatchOppAction</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>opportunityIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <decisions>
        <name>D_Bypass</name>
        <label>Org Automation Bypass?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Act_StampOpp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run</defaultConnectorLabel>
        <rules>
            <name>r_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frm_FlowDisabled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Disabled — exit</label>
        </rules>
    </decisions>
    <description>REV-60 Layer 2 safety net — calls the ALM Promo/Dispatch engine for an opportunity's ALM product lines (catches non-CPQ / manual / data-load paths). Mirrors REV-71's Opp_ALM_Code_AfterSave: org bypass + kill switches + fault logging (the engine self-logs to Flow_Log__c). Inert until ALM_Code_Engine_Settings.Control switches are flipped on. Bulk-safe: the invocable is auto-bulkified across the trigger batch.</description>
    <environments>Default</environments>
    <formulas>
        <name>frm_FlowDisabled</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Autolaunch_Lightning_Flow__c}</expression>
    </formulas>
    <interviewLabel>Opp ALM PromoDispatch AfterSave {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp ALM PromoDispatch AfterSave (REV-60)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_Bypass</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Amount}), ISCHANGED({!$Record.HasOpportunityLineItem}))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1010</triggerOrder>
</Flow>
