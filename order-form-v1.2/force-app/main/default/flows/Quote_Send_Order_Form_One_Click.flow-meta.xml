    <screens>
        <name>Screen_Renewal_Scope</name>
        <label>Renewals join on 1 January</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>RenewalScopeText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;This renewal is not on the Order Form yet.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Renewals use the Order Form only when the new term starts on or after &lt;b&gt;1 January 2027&lt;/b&gt;. This quote&amp;#39;s start date is before then (or not set), so it continues on the current process. Nothing has been sent.&lt;/p&gt;&lt;p&gt;If the start date is wrong, correct it on the quote and try again. If this deal genuinely needs the Order Form sooner, contact the CRM team.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Not_Approved</name>
        <label>Quote not approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NotApprovedText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;This quote is not Approved.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Current status: {!Get_Quote.SBQQ__Status__c}. The Order Form can only be sent for signature once approval is complete.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Signatory</name>
        <label>No signatory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoSignatoryText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;We don't know who signs this Order Form.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The signer is the quote's Signatory Contact, which fills itself from the Primary Contact on save. Check the Primary Contact is set, save the quote, and try again — or set the Signatory Contact directly if someone else signs (a director, GC, procurement).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Headcount_Missing</name>
        <label>Firmwide headcount missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>HeadcountMissingText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;A Law.com firmwide line has no Authorised User count.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Line: {!Get_Firmwide_No_Headcount.SBQQ__ProductName__c}&lt;/p&gt;&lt;p&gt;The Firmwide License sentence prints the customer&amp;#39;s approximate Authorised User count and its notify threshold, and we hold no attorney count for this account. Enter the Warranted Headcount on the quote line (Licence Model section, or the quote line editor), regenerate the document, and try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_BG_Incomplete</name>
        <label>Benefiting Group wording missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>BGIncompleteText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;A Benefiting Group licence has no group definition.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Line: {!Get_Incomplete_BG_Line.SBQQ__ProductName__c}&lt;/p&gt;&lt;p&gt;The Order Form would print a bare "Benefiting Group" with no description of who is covered. On the quote line, fill in the Benefiting Group Description (preferred) or the Function Name and Group Size, regenerate the document, and try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Wrong_Template</name>
        <label>Latest document is not the Order Form</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>WrongTemplateText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;The most recent document on this quote was not generated with the Subscription Order Form template.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Latest document: {!Get_Quote_Document.Name} (template: {!Get_Quote_Document.SBQQ__Template__c}). Nothing has been sent.&lt;/p&gt;&lt;p&gt;Open &lt;b&gt;Generate Document&lt;/b&gt;, pick the &lt;b&gt;Subscription Order Form&lt;/b&gt; template, generate, and try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
