<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Opp_Created_This_Week__c</fullName>
    <description>Number of New Business Opportunities created this week</description>
    <externalId>false</externalId>
    <formula>IF(
AND(RecordType.Name = &quot;New Business&quot; 
,

ISOWEEK(CreatedDate) = ISOWEEK(TODAY())
)
,
1,
0
)</formula>
    <inlineHelpText>Number of New Business Opportunities created this week</inlineHelpText>
    <label>New Opps Created This Week (Vol)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
