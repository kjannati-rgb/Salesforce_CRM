    <formulas>
        <name>formula_TRUE_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.SBQQ__RequiredBy__c} )),
OR(
ISCHANGED({!$Record.Free_Prose_Title__c} ),
AND(ISNEW(),NOT(ISBLANK({!$Record.Free_Prose_Title__c} )))
)
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.SBQQ__RequiredBy__c} )),
OR(
ISCHANGED({!$Record.Content_Type__c}  ),
AND(ISNEW(),NOT(ISBLANK(TEXT({!$Record.Content_Type__c} ))))
))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_15</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.SBQQ__RequiredBy__c} )),
OR(
ISCHANGED({!$Record.Bio_Taker__c} ),
AND(ISNEW(),NOT(ISBLANK({!$Record.Bio_Taker__c})))
))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_17</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.SBQQ__RequiredBy__c} )),
OR(
ISCHANGED({!$Record.Order_Year__c}  ),
AND(ISNEW(),NOT(ISBLANK(TEXT({!$Record.Order_Year__c} ))))
))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.SBQQ__RequiredBy__c} )),
NOT(CONTAINS({!$Record.CS_Title__c}, &quot;Bespoke Social Media Card&quot;)),
NOT(CONTAINS({!$Record.CS_Title__c}, &quot;Bespoke Logo&quot;)),
NOT(CONTAINS({!$Record.CS_Title__c}, &quot;Banner Advertisement&quot;)),
OR(
ISCHANGED({!$Record.Content_Slot__c}),
AND(ISNEW(),NOT(ISBLANK({!$Record.Content_Slot__c} )))
)
)</expression>
    </formulas>
