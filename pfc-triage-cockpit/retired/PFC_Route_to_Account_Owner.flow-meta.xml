    <screens>
        <name>Screen_Confirm</name>
        <label>Route to Account Owner</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Post_Mention</targetReference>
        </connector>
        <fields>
            <name>ConfirmIntro</name>
            <fieldText>&lt;p&gt;This form completion belongs to &lt;b&gt;{!Get_Account.Name}&lt;/b&gt;, owned by &lt;b&gt;{!Get_Owner.Name}&lt;/b&gt;. Continuing posts a Chatter mention on this record and creates a review Task for them (due in 2 days).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>NoteText</name>
            <fieldText>Add a note for the account owner (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
