    <description>This flow calculates the difference in total between old and new deal</description>
    <environments>Default</environments>
    <formulas>
        <name>calculate_change_in_price</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.TotalPrice}-{!previous_amount_currency_balance}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>converted_previous_amount</name>
        <dataType>Number</dataType>
        <expression>{!previous_amount_currency_balance}*{!conversion_ratio}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currrency_conversion</name>
        <dataType>Number</dataType>
        <expression>CURRENCYRATE(text({!$Record.CurrencyIsoCode}))/CURRENCYRATE(previous_currency)</expression>
        <scale>4</scale>
    </formulas>
