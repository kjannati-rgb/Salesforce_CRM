    <formulas>
        <name>DealType</name>
        <dataType>String</dataType>
        <expression>IF(  
text({!$Record.Opportunity.Type} )= &quot;Cancellation&quot; &amp;&amp; 
(text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  )= &quot;Renewal&quot; || 
text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  )= &quot;Repeat Business&quot; || 
text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  )= &quot;Auto-Renewal&quot;), &quot;Renewals&quot;, 
IF( 
text({!$Record.Opportunity.Type} )= &quot;Cancellation&quot; &amp;&amp; 
(text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  ) = &quot;New Business&quot; || 
text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  )= &quot;Upsell&quot; || 
text({!$Record.Opportunity.Cancelled_Opportunity__r.Type}  )= &quot;Downgrade&quot;), &quot;New Business&quot;, 
IF( 
text({!$Record.Opportunity.Type} )= &quot;Renewal&quot; || 
text({!$Record.Opportunity.Type} ) = &quot;Repeat Business&quot; || 
text({!$Record.Opportunity.Type} )= &quot;Auto-Renewal&quot;, &quot;Renewals&quot;, 
IF( 
text({!$Record.Opportunity.Type} ) = &quot;New Business&quot; || 
text({!$Record.Opportunity.Type} )= &quot;Downgrade&quot; || 
text({!$Record.Opportunity.Type} )= &quot;Upsell&quot;, &quot;New Business&quot;, null ) ) ) )</expression>
    </formulas>
