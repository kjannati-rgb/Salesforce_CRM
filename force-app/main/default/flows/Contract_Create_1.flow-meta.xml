        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__Opportunity__r.Owner.Renewal_Opportunity_Owner__c} ), 
{!$Record.SBQQ__Opportunity__r.OwnerId},
{!$Record.SBQQ__Opportunity__r.Owner.Renewal_Opportunity_Owner__c}
)</expression>
    </formulas>
