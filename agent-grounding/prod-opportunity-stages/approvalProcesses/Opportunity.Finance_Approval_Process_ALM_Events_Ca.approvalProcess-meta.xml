<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StageName</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>disha.shukla@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>leslie.perry@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>nikita.jaiswal@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>payal.moreshwar-ghagargunde@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>ravindraanandrao.chavan@alm.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>shaik.fiaz@alm.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Finance Approval - ALM Events Cancellation</label>
        <name>Finance_Approval_ALM_Events_Cancellation</name>
    </approvalStep>
    <emailTemplate>SA_Opportunity_Email_Templates/Opportunity_Approval_Process</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Approved__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Cancellation - Pending Review</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Closed_Won_Cancellation</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Finance_Submitted_to_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Approved_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Close_date</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opportunity_Approved_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Rejection_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Rejected_Submitted_to_Approval_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stage_Contract_Out</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>true</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Finance Approval Process - ALM Events Ca</label>
    <processOrder>5</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
