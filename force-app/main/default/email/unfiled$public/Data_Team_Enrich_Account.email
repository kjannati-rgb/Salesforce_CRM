<html>
<body style="margin:0; padding:0; background:#efeee8;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#efeee8; padding:24px 0;">
<tr><td align="center">
    <table cellpadding="0" cellspacing="0" style="width:600px; max-width:100%; background:#ffffff; border-radius:16px; overflow:hidden; border:1px solid #e1e0d9; border-collapse:separate; font-family:'Helvetica Neue',Arial,sans-serif; color:#003340;">
        <tr>
            <td style="background:#003340; padding:30px 40px 24px; text-align:center; font-family:'Helvetica Neue',Arial,sans-serif;">
                <div style="font-weight:bold; font-size:28px; line-height:1; letter-spacing:.14em; color:#ffffff;">CE<span style="color:#00c8a7">N</span>TELLIC</div>
                <div style="margin-top:9px; font-size:11px; letter-spacing:.32em; color:#80ffff; text-transform:uppercase;">Intelligence &amp; information services</div>
            </td>
        </tr>
        <tr><td style="height:4px; background:#00c8a7; line-height:4px; font-size:0;">&nbsp;</td></tr>
        <tr>
            <td style="padding:28px 40px;">
                <div style="font-weight:bold; font-size:20px; color:#008f96;">Account needs its address completed</div>
                <div style="margin-top:8px; font-size:14px; color:#5c6b6e; line-height:1.5;">An Opportunity was created for this account, but its billing address is incomplete. Please complete the field(s) listed below before this moves further.</div>

                <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px; font-family:'Helvetica Neue',Arial,sans-serif;">
                    <tr><td style="padding:9px 0; color:#5c6b6e; border-bottom:1px solid #efeee8;">Account</td><td style="padding:9px 0; color:#003340; border-bottom:1px solid #efeee8; text-align:right; font-weight:bold;">{!Account.Name}</td></tr>
                    <tr><td style="padding:9px 0; color:#5c6b6e; border-bottom:1px solid #efeee8;">Account ID</td><td style="padding:9px 0; color:#003340; border-bottom:1px solid #efeee8; text-align:right;">{!Account.Salesforce_Account_ID__c}</td></tr>
                    <tr><td style="padding:9px 0; color:#5c6b6e;">Missing</td><td style="padding:9px 0; color:#b8402f; text-align:right; font-weight:bold;">[[MISSING_FIELDS]]</td></tr>
                </table>

                <div style="margin-top:24px;"><a href="{!Account.Link}" style="display:inline-block; background:#008f96; color:#ffffff; text-decoration:none; font-weight:bold; font-size:14px; padding:12px 24px; border-radius:8px;">Open the account to complete its address</a></div>
                <div style="margin-top:24px; font-size:12px; color:#9fc7c6;">Automatic notification &mdash; an Opportunity was created on an account with an incomplete billing address.</div>
            </td>
        </tr>
    </table>
</td></tr>
</table>
</body>
</html>
