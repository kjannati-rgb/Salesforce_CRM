<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <actionCalls>
        <name>Send_Stale_Reminder</name>
        <label>Send Stale Reminder</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Owner:User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>fSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>fBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <decisions>
        <name>Is_Past_Review_Date</name>
        <label>Is Past Review Date?</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Current or no review date</defaultConnectorLabel>
        <rules>
            <name>Stale</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Review_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Review_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Stale_Reminder</targetReference>
            </connector>
            <label>Stale</label>
        </rules>
    </decisions>
    <description>World-Class Agent Standard v2 §1 staleness control: weekly sweep of published Knowledge articles whose Review_Date__c has passed; emails the article owner to re-verify the article against org metadata. Article content is maintained in source control and loaded via scripts/load-knowledge.js — owners fix the repo file, not the article record.</description>
    <environments>Default</environments>
    <formulas>
        <name>fBody</name>
        <dataType>String</dataType>
        <expression>"The Knowledge article '" &amp; {!$Record.Title} &amp; "' passed its review date (" &amp; TEXT({!$Record.Review_Date__c}) &amp; ") and is now treated as stale under the World-Class Agent Standard." &amp; BR() &amp; BR() &amp; "Please re-verify its content against current org metadata. The article source lives in source control (see the article's Summary field for the file path) — update the repo file and reload; do not edit the article directly in Salesforce." &amp; BR() &amp; BR() &amp; "Article: " &amp; LEFT({!$Api.Partner_Server_URL_590}, FIND('/services', {!$Api.Partner_Server_URL_590})) &amp; "lightning/r/Knowledge__kav/" &amp; {!$Record.Id} &amp; "/view"</expression>
    </formulas>
    <formulas>
        <name>fSubject</name>
        <dataType>String</dataType>
        <expression>"Knowledge article past review date: " &amp; {!$Record.Title}</expression>
    </formulas>
    <interviewLabel>Knowledge Article Staleness Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Knowledge Article Staleness Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Past_Review_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <filters>
            <field>Language</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>en_US</stringValue>
            </value>
        </filters>
        <object>Knowledge__kav</object>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2026-07-06</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
