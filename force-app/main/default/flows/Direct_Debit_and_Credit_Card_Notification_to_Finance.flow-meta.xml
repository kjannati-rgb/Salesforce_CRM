    <decisions>
        <name>Product_Type</name>
        <label>Product Type</label>
        <locationX>446</locationX>
        <locationY>935</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_CollectionSize</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Credit_Card_Email_Alert</targetReference>
            </connector>
            <label>Product Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Quote_Direct_Debit_or_Credit_Card_Path</name>
        <label>Quote: Direct Debit or Credit Card Path</label>
        <locationX>446</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Direct_Debit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Quote.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Direct Debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Primary_Quote.SBQQ__Opportunity2__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Direct_Debit_Send_Email</targetReference>
            </connector>
            <label>Direct Debit</label>
        </rules>
        <rules>
            <name>Credit_Card</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Quote.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit Card</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Primary_Quote.SBQQ__Opportunity2__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Lines</targetReference>
            </connector>
            <label>Credit Card</label>
        </rules>
    </decisions>
    <description>This Flow is designed to send email notifications and create tasks for Quotes flagged with Payment Type = Direct Debit or Credit Card.</description>
