<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>SBQQ__PaymentTerms__c</field>
        <field>Payment_Type__c</field>
        <field>SBQQ__AverageCustomerDiscount__c</field>
        <field>SBQQ__NetAmount__c</field>
        <field>Special_Terms__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Special_Terms_Approvers</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.Special_Terms__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Special Terms Approval</label>
        <name>Special_Terms_Approval</name>
    </approvalStep>
    <emailTemplate>SA_Quote_Email_Templates/Quote_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(NOT( $Setup.Application_Settings__c.Disable_Approval_Processes__c ),
NOT(ISBLANK(Special_Terms__c))
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Approved_RT</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Special_Terms_Approval_Email</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Special_Terms_Status_Approve</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Special_Terms_Watermark_FALSE</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Special_Terms_Rejection_Email</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Special_Terms_Status_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Special_Terms_Status_Review</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Special Terms</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Special_Terms_Recall_Email</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Special_Terms_Status_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
