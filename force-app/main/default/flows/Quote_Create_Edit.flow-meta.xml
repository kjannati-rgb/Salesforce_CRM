        IF(  
            TEXT({!$Record.Owner:User.Team__c}) = &quot;Expert Insight - Lexology Panoramic&quot;, &quot;Paid_Content&quot;,  
            IF(  
                TEXT({!$Record.Owner:User.Team__c}) = &quot;Expert Insight - GXRs&quot;, &quot;Paid_Content&quot;,  
