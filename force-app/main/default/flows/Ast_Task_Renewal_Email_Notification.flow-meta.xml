<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <description>to avoid infinite loop</description>
        <name>Adding_comma_at_end</name>
        <label>Adding comma at end</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remainingMessageIds</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>,</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Extracting_message_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Comma_separated_MessageIds</name>
        <label>Comma separated MessageIds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remainingMessageIds</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Renewal_Email_Content.Message_ID__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Adding_comma_at_end</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Extract_Reduce</name>
        <label>Extract &amp; Reduce</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>messageIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>messageId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>remainingMessageIds</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>remainingMessageIdsAfterComma</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Extracting_message_Ids</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Email_Records_Found</name>
        <label>Check Email Records Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Records_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Record Exist</defaultConnectorLabel>
        <rules>
            <name>Yes_Record_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Email_Status_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Renewal_Email_Notification</targetReference>
            </connector>
            <label>Yes, Record Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Extracting_message_Ids</name>
        <label>Extracting message Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Email_Status_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No more Ids to process</defaultConnectorLabel>
        <rules>
            <name>More_Ids_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>remainingMessageIds</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>remainingMessageIds</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Extract_Reduce</targetReference>
            </connector>
            <label>More Ids Exist</label>
        </rules>
    </decisions>
    <description>This Flow is used to show the renewal email notification event table in the task tab.</description>
    <environments>Default</environments>
    <formulas>
        <name>messageId</name>
        <dataType>String</dataType>
        <expression>TRIM( LEFT( {!remainingMessageIds}, FIND(&quot;,&quot;, {!remainingMessageIds}) - 1 ) )</expression>
    </formulas>
    <formulas>
        <name>remainingMessageIdsAfterComma</name>
        <dataType>String</dataType>
        <expression>TRIM( RIGHT( {!remainingMessageIds}, LEN({!remainingMessageIds}) - FIND(&quot;,&quot;, {!remainingMessageIds}) ) )</expression>
    </formulas>
    <interviewLabel>R {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task Renewal Email Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Email_Status_Records</name>
        <label>Email Status Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Email_Records_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Message_ID__c</field>
            <operator>In</operator>
            <value>
                <elementReference>messageIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Renewal_Notification_Email_Status__c</object>
        <sortField>Action_Date_Time__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Renewal_Email_Content</name>
        <label>Renewal Email Content</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Comma_separated_MessageIds</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Task_Record.Renewal_Email_Content__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Renewal_Email_Content__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Message_ID__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Task_Record</name>
        <label>Task Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Renewal_Email_Content</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Renewal_Email_Content__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
