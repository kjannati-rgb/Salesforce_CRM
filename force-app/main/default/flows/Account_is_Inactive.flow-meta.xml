<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <description>When an Account transitions to Status = Inactive, flags all related Contacts as &quot;Not at Company&quot; (LID__No_longer_at_Company__c) and bulk-updates them. Gated by doesRequireRecordChangedToMeetCriteria so it fires only on the change into Inactive, not on every subsequent save of an already-inactive account.</description>
    <assignments>
        <description>Adds all the Contacts that have gone through the Loop and flagged with &quot;Not at Company&quot; to a Collection Variable ready in the next step to Update all the Contacts in the CRM.</description>
        <name>Add_to_Collection_of_Contacts</name>
        <label>Add to Collection of Contacts</label>
        <locationX>264</locationX>
        <locationY>695</locationY>
        <assignmentItems>
            <assignToReference>CollectionofContactstoUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>My_Contact_Loop</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>My_Contact_Loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Takes the current Contact in the Loop and flags them via this Assignment as &quot;Not at Company&quot;.</description>
        <name>Assign_Opt_Out_Value</name>
        <label>Assign Opt Out Value</label>
        <locationX>264</locationX>
        <locationY>575</locationY>
        <assignmentItems>
            <assignToReference>My_Contact_Loop.LID__No_longer_at_Company__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not at Company</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection_of_Contacts</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>Account is Inactive {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account is Inactive</label>
    <loops>
        <description>This loop takes the Contacts from related Account and adds them to the Loop.</description>
        <name>My_Contact_Loop</name>
        <label>My Contact Loop</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <collectionReference>Get_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Opt_Out_Value</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Contacts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>My_Contact_Loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Physically updates all Contacts with an Inactive Account with &quot;Not at Company&quot;.</description>
        <name>Update_Contacts</name>
        <label>Update Contacts</label>
        <locationX>176</locationX>
        <locationY>911</locationY>
        <faultConnector>
            <targetReference>Log_Flow_Error</targetReference>
        </faultConnector>
        <inputReference>CollectionofContactstoUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contacts</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Log_Flow_Error</name>
        <label>Log Flow Error</label>
        <locationX>440</locationX>
        <locationY>911</locationY>
        <flowName>Flow_log_v3</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_flowname</name>
            <value>
                <stringValue>Account_is_Inactive</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_recordname</name>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>CollectionofContactstoUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
