<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Count_Segments</name>
        <label>Count Segments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>count_mdq_segments</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Quote_lines_for_similar_products</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>expected_segments</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>calculate_segments</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_if_expected_segments_are_created</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>MDQ_Error</name>
        <label>MDQ Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>As this is a multi year deal, please create correct number of segments. Expected number of segments = {!expected_segments}, segments created = {!count_mdq_segments}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_division</name>
        <label>Check division</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ALM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Product__r.Division__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ALM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Bundle__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_term</targetReference>
            </connector>
            <label>ALM</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_expected_segments_are_created</name>
        <label>Check if expected segments are created</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>MDQ_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>expected_segments</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>count_mdq_segments</elementReference>
                </rightValue>
            </conditions>
            <label>Created</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_term</name>
        <label>Check term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X12</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__EffectiveSubscriptionTerm__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>12.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Skip_print_products</targetReference>
            </connector>
            <label>&gt;12</label>
        </rules>
    </decisions>
    <decisions>
        <name>Skip_print_products</name>
        <label>Skip print products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Quote_lines_for_similar_products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Skip</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NYLM</stringValue>
                </rightValue>
            </conditions>
            <label>Skip</label>
        </rules>
    </decisions>
    <description>MDQ Segment check for ALM</description>
    <environments>Default</environments>
    <formulas>
        <name>calculate_segments</name>
        <dataType>Number</dataType>
        <expression>CEILING({!$Record.SBQQ__EffectiveSubscriptionTerm__c}/12)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>QuoteLine_AfterSave_MDQ_Segment_Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QuoteLine_AfterSave_MDQ_Segment_Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote_lines_for_similar_products</name>
        <label>Get Quote lines for similar products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Segments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Quote__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SBQQ__Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Product__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SBQQ__Bundle__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_division</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Division__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ALM</stringValue>
            </value>
        </filters>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>count_mdq_segments</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
