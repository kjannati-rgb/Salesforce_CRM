        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_for_not_at_company_flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsHubspot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.LeadSource</leftValueReference>
