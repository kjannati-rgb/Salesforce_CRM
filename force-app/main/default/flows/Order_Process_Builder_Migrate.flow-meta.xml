    <formulas>
        <name>CheckforDisableProcesses</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Process_Builders__c}</expression>
    </formulas>
    <formulas>
        <name>ISNEWFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(),NOT(ISBLANK({!$Record.SBQQ__Quote__c})),
NOT(ISBLANK({!$Record.SBQQ__Quote__r.SBQQ__PrimaryContact__c} )))</expression>
    </formulas>
    <formulas>
        <name>UpdateOrderFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(), ({!$Record.IsReductionOrder}=False))</expression>
    </formulas>
    <formulas>
        <name>UpdateUltimateAcc</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(ISNEW() ,ISCHANGED ({!$Record.AccountId})), NOT(ISBLANK({!$Record.Account.Ultimate_Account__c})))</expression>
    </formulas>
