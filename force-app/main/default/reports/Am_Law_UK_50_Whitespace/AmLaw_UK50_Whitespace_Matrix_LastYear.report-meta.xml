<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Am Law UK 50 Whitespace (Last Yr)</name>
    <description>Am Law UK 50 active coverage as of 1 year ago. Rows = firm by rank; cols = product family. Active = Closed Won line live as of 365 days ago (Daniel's LY logic), corrected 11 families, cohort = firm rank not null. Measure = line ACV (GBP).</description>
    <format>Matrix</format>
    <reportType>Custom_Opportunities_with_Products__c</reportType>
    <currency>GBP</currency>
    <columns>
        <aggregateTypes>Minimum</aggregateTypes>
        <field>Opportunity$Ultimate_Account__c.Am_Law_UK_50_Rank__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.OpportunityLineItems$Annual_Contract_Value__c.CONVERT</field>
    </columns>
    <groupingsDown>
        <aggregateType>Minimum</aggregateType>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Ultimate_Account__c</field>
        <sortByName>Opportunity$Ultimate_Account__c.Am_Law_UK_50_Rank__c</sortByName>
        <sortOrder>Asc</sortOrder>
        <sortType>Aggregate</sortType>
    </groupingsDown>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.OpportunityLineItems$Product_Family__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <filter>
        <booleanFilter>1 AND 2 AND (3 OR 4) AND (5 OR 6) AND 7 AND 8 AND 9 AND 10</booleanFilter>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Closed Won</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notContain</operator>
            <value>cancel,delete,test,duplicate</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityLineItems$Start_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>N_DAYS_AGO:365</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityLineItems$Start_Date_SUN_Report__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>N_DAYS_AGO:365</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityLineItems$End_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>N_DAYS_AGO:365</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityLineItems$End_Date_SUN_Report__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>N_DAYS_AGO:365</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Cancelled__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Amount</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>GBP 0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityLineItems$Product_Family__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Expert Insight -,Performance,Specialist,Panoramic,In-Depth,Index,Lexology Pro,Specialist Platforms,Docket,Intelligence,Compete</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Ultimate_Account__c.Am_Law_UK_50_Rank__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
    </filter>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>
