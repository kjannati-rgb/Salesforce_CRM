<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <decisions>
        <description>Check if the custom setting governing disabling of flows is set</description>
        <name>Check_Disable_Processes</name>
        <label>Check Disable Processes</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Get_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Disable Flow is not set</defaultConnectorLabel>
        <rules>
            <name>Disable_Flow_is_set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DisableAutoLaunchFlow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Disable Flow is set</label>
        </rules>
    </decisions>
    <description>Approved and Direct Debit
Quote &gt; Payment Type &gt; Direct Debit. If this is value is selected on the Quote and the User Submits for Approval it should a new Task and assign it to the Finance Queue.</description>
    <environments>Default</environments>
    <formulas>
