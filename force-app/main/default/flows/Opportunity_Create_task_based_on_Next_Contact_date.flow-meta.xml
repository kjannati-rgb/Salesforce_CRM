<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <decisions>
        <name>Check_for_New_Existing_Opportunity</name>
        <label>Check for New/Existing Opportunity</label>
        <locationX>440</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>New_Opportunity_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewOpportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Next_Contact_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_Task</targetReference>
            </connector>
            <label>New Opportunity Record</label>
        </rules>
        <rules>
            <name>Existing_record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Next_Contact_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
            <label>Existing record</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Process_Disable_Process</name>
        <label>Check Process Disable Process</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Get_Opportunity_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Process_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckDisableProcess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Process Disabled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CalculateDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Next_Contact_Date__c})+&quot; &quot; +&apos;07:30:00&apos;)</expression>
    </formulas>
    <formulas>
        <name>CheckDisableProcess</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Process_Builders__c}</expression>
    </formulas>
    <formulas>
        <name>NewOpportunity</name>
        <dataType>Boolean</dataType>
        <expression>isnew()</expression>
    </formulas>
