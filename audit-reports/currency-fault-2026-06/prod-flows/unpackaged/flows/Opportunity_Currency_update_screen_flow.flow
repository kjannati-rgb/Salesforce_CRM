            <value>
                <stringValue>Identify</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_opportunity_Stage2</name>
        <label>Update opportunity Stage</label>
        <locationX>578</locationX>
        <locationY>998</locationY>
        <connector>
            <targetReference>Update_Primary_quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
