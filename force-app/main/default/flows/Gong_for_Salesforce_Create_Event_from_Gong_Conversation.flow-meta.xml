            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>New_Event.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Gong Conversation</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Event</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>Event_Description</name>
        <dataType>String</dataType>
        <expression>&apos;See the call recording and summary at https://app.gong.io/call?id=&apos; &amp; {!$Record.Gong__Call_ID__c} &amp; BR() &amp; BR() &amp; {!$Record.Gong__Call_Brief__c}</expression>
    </formulas>
    <formulas>
        <description>This resource keeps the conversation primary opportunity, or primary account, or none of them</description>
        <name>Related_To</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.Gong__Primary_Opportunity__c}), {!$Record.Gong__Primary_Opportunity__c}, {!$Record.Gong__Primary_Account__c})</expression>
    </formulas>
