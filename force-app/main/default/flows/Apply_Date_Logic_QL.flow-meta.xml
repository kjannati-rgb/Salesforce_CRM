    <formulas>
        <name>EffectiveEndDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISPICKVAL({!$Record.SBQQ__SubscriptionType__c}, &quot;Evergreen&quot;), null,
IF(ISBLANK({!$Record.SBQQ__EndDate__c}),
IF(ISBLANK({!$Record.SBQQ__Group__r.SBQQ__EndDate__c}),{!$Record.SBQQ__Quote__r.SBQQ__EndDate__c},{!$Record.SBQQ__Group__r.SBQQ__EndDate__c}),
{!$Record.SBQQ__EndDate__c}
))</expression>
    </formulas>
    <formulas>
        <name>EffectiveStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__StartDate__c}),
IF(ISBLANK({!$Record.SBQQ__Group__r.SBQQ__StartDate__c}),{!$Record.SBQQ__Quote__r.SBQQ__StartDate__c},{!$Record.SBQQ__Group__r.SBQQ__StartDate__c}),
{!$Record.SBQQ__StartDate__c}
)</expression>
    </formulas>
    <formulas>
        <name>EffectiveSubscriptionTerm</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__SubscriptionTerm__c}),
IF(ISBLANK({!$Record.SBQQ__Group__r.SBQQ__SubscriptionTerm__c}),{!$Record.SBQQ__Quote__r.SBQQ__SubscriptionTerm__c},{!$Record.SBQQ__Group__r.SBQQ__SubscriptionTerm__c}),
{!$Record.SBQQ__SubscriptionTerm__c}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>EndDate8Weeks</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__EndDate__c}),
{!$Record.SBQQ__Quote__r.SBQQ__Opportunity2__r.CloseDate}+56,
{!$Record.SBQQ__EndDate__c}
)</expression>
    </formulas>
    <formulas>
        <name>StartDate8Weeks</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__StartDate__c}),
{!$Record.SBQQ__Quote__r.SBQQ__Opportunity2__r.CloseDate}+56,
{!$Record.SBQQ__StartDate__c}
)</expression>
    </formulas>
    <formulas>
        <name>SubsCalculatedEndDate</name>
        <dataType>Date</dataType>
        <expression>IF( !ISBLANK({!EffectiveEndDate}),
{!EffectiveStartDate},
ADDMONTHS( {!EffectiveStartDate}, {!EffectiveSubscriptionTerm} )-1
)</expression>
    </formulas>
