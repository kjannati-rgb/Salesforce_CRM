    <assignments>
        <name>Add_to_variables</name>
        <label>Add to variables</label>
        <locationX>505</locationX>
        <locationY>304</locationY>
        <assignmentItems>
            <assignToReference>vAllElapsedTImes</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_milestones.ElapsedTimeInMins</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vNumberofMilestones</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_milestones</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>fAverage</name>
        <dataType>Number</dataType>
        <expression>{!vAllElapsedTImes} / {!vNumberofMilestones}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fHoursMins</name>
        <dataType>String</dataType>
        <expression>TEXT(FLOOR({!fAverage}/ 60))
&amp;&apos;hr &apos;&amp; 
TEXT(MOD({!fAverage},60))
&amp;&apos;min&apos;</expression>
    </formulas>
    <formulas>
        <name>fTodayMinus7</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 7</expression>
    </formulas>
