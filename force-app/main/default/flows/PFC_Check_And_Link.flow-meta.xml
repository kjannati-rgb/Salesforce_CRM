    <description>REV-57 shared cross-linker. On PFC create or when Lead/Contact changes (incl. after conversion relink), finds the most recent OPEN PFC for the same person + same brand-grain product and sets Related_Form_Completion__c on this record. Skips when brand is blank or Other. Symmetric: matches new (Product_Brand__c) and legacy (Brand__c) records.</description>
    <environments>Default</environments>
    <formulas>
        <name>brandToMatch</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK(TEXT({!$Record.Product_Brand__c}))), TEXT({!$Record.Product_Brand__c}), {!$Record.Brand__c})</expression>
    </formulas>
    <interviewLabel>PFC Check And Link {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PFC Check And Link</label>
    <processMetadataValues>
