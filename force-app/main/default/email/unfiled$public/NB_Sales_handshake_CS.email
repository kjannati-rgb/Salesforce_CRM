<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#e8eae6;mso-table-lspace:0;mso-table-rspace:0"><tr><td align="center" style="padding:24px 12px;font-family:'Helvetica Neue',Arial,sans-serif">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" align="center" style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e1e0d9;border-collapse:separate;mso-table-lspace:0;mso-table-rspace:0;font-family:'Helvetica Neue',Arial,sans-serif;color:#003340">

<tr><td style="background:#003340;padding:30px 40px 24px;text-align:center;font-family:'Helvetica Neue',Arial,sans-serif">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:bold;font-size:28px;line-height:1;letter-spacing:.14em;color:#ffffff">CE<span style="color:#00c8a7">N</span>TELLIC</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:9px;font-size:11px;letter-spacing:.32em;color:#80ffff;text-transform:uppercase">Intelligence &amp; information services</div>
</td></tr>
<tr><td style="height:4px;background:#00c8a7;font-size:0;line-height:0">&nbsp;</td></tr>

<tr><td style="background:#ffffff;padding:34px 40px 8px;font-family:'Helvetica Neue',Arial,sans-serif">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;font-weight:bold;letter-spacing:.2em;color:#008ca6;text-transform:uppercase">Sales handshake &middot; Content subscriptions</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin:12px 0 6px;font-weight:bold;font-size:26px;line-height:1.25;color:#003340">New business win &mdash; {!Customer_Journey__c.Account_name__c}</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;line-height:1.6;color:#5c6b6e">A new Sales Handshake has been created. Here's everything you need to pick this account up and run with it.</div>
</td></tr>

<tr><td style="background:#ffffff;padding:22px 40px 6px;font-family:'Helvetica Neue',Arial,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate"><tr>
<td width="33%" valign="top" style="padding:6px"><div style="background:#e8f6f2;border-radius:12px;padding:16px 10px;text-align:center">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.08em;color:#008ca6;text-transform:uppercase">Annual value</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:6px;font-weight:bold;font-size:18px;line-height:1.2;color:#003340">{!Customer_Journey__c.Amount__c}</div></div></td>
<td width="33%" valign="top" style="padding:6px"><div style="background:#e8f6f2;border-radius:12px;padding:16px 10px;text-align:center">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.08em;color:#008ca6;text-transform:uppercase">Goal licences</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:6px;font-weight:bold;font-size:18px;line-height:1.2;color:#003340">{!Customer_Journey__c.Goal_Licenses__c}</div></div></td>
<td width="33%" valign="top" style="padding:6px"><div style="background:#e8f6f2;border-radius:12px;padding:16px 10px;text-align:center">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.08em;color:#008ca6;text-transform:uppercase">Seat banding</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:6px;font-weight:bold;font-size:18px;line-height:1.2;color:#003340">{!Customer_Journey__c.Seat_Banding_Content_Subs__c}</div></div></td>
</tr></table></td></tr>

<tr><td style="background:#ffffff;padding:14px 40px 0;font-family:'Helvetica Neue',Arial,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td style="border-left:3px solid #00c8a7;background:#f6f5f1;padding:14px 16px;font-family:'Helvetica Neue',Arial,sans-serif">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;font-weight:bold;letter-spacing:.12em;color:#008ca6;text-transform:uppercase">Opportunity</div>
<div style="font-family:'Helvetica Neue',Arial,sans-serif;margin-top:5px;font-size:14px;line-height:1.5;color:#003340">{!Customer_Journey__c.Opportunity__c}</div>
</td></tr></table></td></tr>

<tr><td style="background:#ffffff;padding:24px 40px 4px;font-family:'Helvetica Neue',Arial,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px">
<tr><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8;width:46%">Sector / industry</td><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;font-weight:bold;border-bottom:1px solid #efeee8;text-align:right">{!Customer_Journey__c.Sector_Industry__c}</td></tr>
<tr><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">Organisation type</td><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;font-weight:bold;border-bottom:1px solid #efeee8;text-align:right">{!Customer_Journey__c.Organisation_type__c}</td></tr>
<tr><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e;border-bottom:1px solid #efeee8">Product purchased</td><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;font-weight:bold;border-bottom:1px solid #efeee8;text-align:right">{!Customer_Journey__c.Product_Purchased__c}</td></tr>
<tr><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#5c6b6e">Work areas &amp; jurisdictions</td><td style="font-family:'Helvetica Neue',Arial,sans-serif;padding:9px 0;color:#003340;font-weight:bold;text-align:right">{!Customer_Journey__c.Work_areas_Jurisdictions__c}</td></tr>
</table></td></tr>

<tr><td style="background:#ffffff;padding:22px 40px 0;font-family:'Helvetica Neue',Arial,sans-serif">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;font-weight:bold;letter-spacing:.14em;color:#008ca6;text-transform:uppercase;margin-bottom:10px">Main contact</div>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td style="background:#f6f5f1;border-radius:12px;padding:14px 16px;font-family:'Helvetica Neue',Arial,sans-serif">
<div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;font-weight:bold;color:#003340">{!Customer_Journey__c.Main_Contact_name__c}</div>
