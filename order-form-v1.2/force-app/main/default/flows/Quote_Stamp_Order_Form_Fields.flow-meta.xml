    <environments>Default</environments>
    <formulas>
        <name>AMName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__SalesRep__c}), "", TRIM({!$Record.SBQQ__SalesRep__r.FirstName} &amp; " " &amp; {!$Record.SBQQ__SalesRep__r.LastName}))</expression>
    </formulas>
    <formulas>
        <name>AMEmailPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SBQQ__SalesRep__c}), "", {!$Record.SBQQ__SalesRep__r.Email} &amp; IF(ISBLANK({!$Record.SBQQ__SalesRep__r.Phone}), "", " / " &amp; {!$Record.SBQQ__SalesRep__r.Phone}))</expression>
    </formulas>
    <formulas>
        <name>BillingEntityText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.SBQQ__Opportunity2__r.Billing_Entity__c})</expression>
    </formulas>
    <formulas>
