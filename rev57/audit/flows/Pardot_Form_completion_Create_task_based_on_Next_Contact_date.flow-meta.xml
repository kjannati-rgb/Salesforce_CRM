        <defaultConnector>
            <targetReference>Create_Flow_Log_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Process_disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkDisableProcess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Process disabled</label>
        </rules>
    </decisions>
