        <label>Form Name Mapped?</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>No mapping - leave Campaign unchanged</defaultConnectorLabel>
        <rules>
            <name>Mapped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Campaign_Mapping.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Campaign</targetReference>
            </connector>
            <label>Mapped</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_CampaignFound</name>
        <label>Campaign Exists?</label>
        <locationX>176</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>Not in this org - leave Campaign unchanged</defaultConnectorLabel>
        <rules>
            <name>CampaignFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Campaign.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Campaign</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Stamps Name/Account/Campaign on a PFC when Lead/Contact is set. REV-57 follow-up: Campaign is now resolved via PFC_Campaign_Mapping__mdt (Form Name -> Campaign Name) + a by-name Get Records, replacing hardcoded Campaign Ids (sandbox-safe, config-driven).</description>
    <environments>Default</environments>
    <formulas>
        <name>ContactAccount</name>
        <dataType>String</dataType>
        <expression>{!$Record.Contact__r.Account.Id}</expression>
    </formulas>
    <formulas>
        <name>FormName</name>
        <dataType>String</dataType>
        <expression>({!$Record.Prospect_Name__c} &amp; &quot; | &quot; &amp; TEXT({!$Record.Form_Name__c}))</expression>
    </formulas>
    <formulas>
        <name>FormName2</name>
        <dataType>String</dataType>
        <expression>LEFT(
({!$Record.Prospect_Name__c} &amp; &quot; | &quot; &amp; TEXT({!$Record.Form_Name__c})),
80)</expression>
    </formulas>
    <interviewLabel>On Pardot Form Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>On Pardot Form Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
