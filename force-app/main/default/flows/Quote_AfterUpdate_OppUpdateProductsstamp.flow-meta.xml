    <description>This flow updates the opportunity fields (products checkbox) depending upon the products in quote line</description>
    <environments>Default</environments>
    <formulas>
        <name>fbandingSP</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS ({!Loop_through_quote_lines.SBQQ__ProductName__c}, &quot;Individual&quot;), &quot;1&quot;,
IF(CONTAINS ({!Loop_through_quote_lines.SBQQ__ProductName__c}, &quot;Team&quot;), &quot;3&quot;, 
IF(CONTAINS ({!Loop_through_quote_lines.SBQQ__ProductName__c}, &quot;Office&quot;), &quot;10&quot;,
IF(CONTAINS ({!Loop_through_quote_lines.SBQQ__ProductName__c}, &quot;Firmwide&quot;), &quot;20&quot;, 
&quot; &quot;))))</expression>
    </formulas>
    <formulas>
        <name>fname</name>
        <dataType>String</dataType>
        <expression>LEFT({!productlist},255)</expression>
    </formulas>
    <formulas>
        <name>fName2</name>
        <dataType>String</dataType>
        <expression>LEFT({!productlist},255)</expression>
    </formulas>
    <formulas>
        <name>productlist</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!fproductname}, 1) = &quot;;&quot;, LEFT({!fproductname}, LEN({!fproductname}) - 1), {!fproductname})</expression>
    </formulas>
    <interviewLabel>Quote_AfterUpdate_OppUpdateProductsstamp {!$Flow.CurrentDateTime}</interviewLabel>
