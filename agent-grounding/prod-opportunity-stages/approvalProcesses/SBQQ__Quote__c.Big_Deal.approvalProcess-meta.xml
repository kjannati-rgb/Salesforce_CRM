<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>SBQQ__PaymentTerms__c</field>
        <field>Payment_Type__c</field>
        <field>SBQQ__AverageCustomerDiscount__c</field>
        <field>SBQQ__NetAmount__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Finance_Approvers</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Big Deal Approval</label>
        <name>Big_Deal_Approval</name>
    </approvalStep>
    <emailTemplate>SA_Quote_Email_Templates/Quote_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(NOT( $Setup.Application_Settings__c.Disable_Approval_Processes__c ),
 IF( SBQQ__NetAmount__c &gt;50000, TRUE, FALSE) 
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Approved_RT</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Big_Deal_Approval_Message</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Big_Deal_Status_Approve</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Big_Deal_Watermark_FALSE</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Big_Deal_Rejection_Email</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Big_Deal_Status_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Big_Deal_Status_Review</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Big Deal</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Big_Deal_Draft</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Big_Deal_Recall_Email</name>
            <type>Alert</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
