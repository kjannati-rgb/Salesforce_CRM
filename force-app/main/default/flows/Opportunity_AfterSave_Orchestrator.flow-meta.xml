<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>CENTELLIC REFERENCE (Draft/inert) — the after-save orchestrator pattern from the Automation Standard. ONE after-save flow per object: checks the org bypass, then calls each concern as a subflow IN A DEFINED ORDER, every call fault-guarded to Platform_Fault_Logger. During Phase C the legacy Opportunity after-save flows are ported into the subflow slots and this is activated; the legacy flows are then retired. Shipped as Draft so it does not execute. The Get_Account element is an illustrative concern showing the fault-path wiring.</description>
    <decisions>
        <name>D_Bypass</name>
        <label>Automation Bypassed?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Get_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run</defaultConnectorLabel>
        <rules>
            <name>r_Bypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frm_Bypass</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypassed — exit</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frm_Bypass</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Autolaunch_Lightning_Flow__c}</expression>
    </formulas>
    <interviewLabel>Opportunity AfterSave Orchestrator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity AfterSave Orchestrator</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Concern: Get Account (illustrative)</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_Bypass</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Log_Fault</name>
        <label>Log Fault</label>
        <locationX>440</locationX>
        <locationY>386</locationY>
        <flowName>Platform_Fault_Logger</flowName>
        <inputAssignments>
            <name>in_Context</name>
            <value>
                <stringValue>Get_Account</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_ErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_FlowApiName</name>
            <value>
                <stringValue>Opportunity_AfterSave_Orchestrator</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_RecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_RecordName</name>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_Severity</name>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
