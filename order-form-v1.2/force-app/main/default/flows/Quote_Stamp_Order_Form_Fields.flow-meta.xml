    <decisions>
        <name>Decision_Other_Terms</name>
        <label>Product Specific Terms present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Other_Terms_None</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Blank - print None</defaultConnectorLabel>
        <rules>
            <name>Other_Terms_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product_Specific_Terms__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Other_Terms_Copy</targetReference>
            </connector>
            <label>Has Product Specific Terms</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Billing_Found</name>
        <label>Billing entity config found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Entity_Config</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No billing match - fall back to rep entity</defaultConnectorLabel>
        <rules>
            <name>Billing_Config_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Billing_Config</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Stamp_From_Billing</targetReference>
            </connector>
            <label>Billing config found</label>
        </rules>
    </decisions>
