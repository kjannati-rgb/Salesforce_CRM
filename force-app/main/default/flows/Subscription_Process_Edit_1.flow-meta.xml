    <description>Migrated from the Subscription Process - Edit process using multiple criteria.</description>
    <environments>Default</environments>
    <formulas>
        <name>var_processdisabled</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Application_Settings__c.Disable_Process_Builders__c}</expression>
    </formulas>
    <formulas>
        <name>var_ultimateaccount</name>
        <dataType>Boolean</dataType>
        <expression>AND (OR( ISNEW(), ISCHANGED({!$Record.SBQQ__Account__c}  )), 
NOT(ISBLANK({!$Record.SBQQ__Account__r.Ultimate_Account__c}  )))</expression>
    </formulas>
