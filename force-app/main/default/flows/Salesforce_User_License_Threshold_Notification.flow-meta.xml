    <apiVersion>52.0</apiVersion>
    <assignments>
        <name>Assign_Remaining_Licences</name>
        <label>Assign Remaining Licences</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>RemainingLicences</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varRemainingLicences</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Less_than_10_Users</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Less_than_10_Users</name>
        <label>Less than 10 Users</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Less_than_10</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RemainingLicences</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Notification</targetReference>
            </connector>
            <label>Less than 10</label>
        </rules>
    </decisions>
    <description>This Flow is designed to alert the Salesforce Admin when the licences hit a certain threshold in order to make sure we have enough available.</description>
    <environments>Default</environments>
    <formulas>
        <name>varEmailBody</name>
        <dataType>String</dataType>
        <expression>&quot;You have &quot; &amp;TEXT({!RemainingLicences})&amp; &quot; Salesforce user licence(s) left. &quot; &amp;TEXT({!varUserLicenceInfo.UsedLicenses})&amp; &quot; out of &quot; &amp;TEXT({!varUserLicenceInfo.TotalLicenses}) &amp; &quot; have been used&quot;</expression>
    </formulas>
    <formulas>
        <name>varRemainingLicences</name>
        <dataType>Number</dataType>
        <expression>{!varUserLicenceInfo.TotalLicenses} - {!varUserLicenceInfo.UsedLicenses}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Alert: You have &quot;&amp;TEXT({!RemainingLicences})&amp; &quot; Salesforce User Licence(s) left&quot;</expression>
    </formulas>
