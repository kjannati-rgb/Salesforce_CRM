    <decisions>
        <name>Check_for_1st_year_Renewal</name>
        <label>Check for 1st year Renewal</label>
        <locationX>974</locationX>
        <locationY>708</locationY>
        <defaultConnector>
            <targetReference>Update_Renewal_Owner3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X1st_year</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Opportunity_Type_Forecast__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Business</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Owner.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Specialist Platforms</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Owner.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lexology Pro</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Renewal_Owner</targetReference>
            </connector>
            <label>1st year</label>
        </rules>
        <rules>
            <name>Not_a_1st_year_renewal</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Opportunity_Type_Forecast__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Owner.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Content Subs</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity__r.Owner.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lex PRO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_non_nascent_owner</targetReference>
            </connector>
            <label>Not a 1st year renewal</label>
        </rules>
    </decisions>
