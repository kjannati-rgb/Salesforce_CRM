    <decisions>
        <name>D_Should_Alert</name>
        <label>Should Send Alert?</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>Log only</defaultConnectorLabel>
        <rules>
            <name>r_Alert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Alert_Setting.Alert_Enabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>in_Severity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Error</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Alert_Setting.Alert_Email_To__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Alert_Email</targetReference>
            </connector>
            <label>Alert enabled + Error + recipient set</label>
        </rules>
    </decisions>
