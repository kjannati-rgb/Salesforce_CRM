<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>REV-57: on Lead conversion, relink related Pardot Form Completions from the Lead to its new Contact. Reacts to the actual conversion event (works for native conversion, not just the Convert button), unlike the legacy Draft flow Move_Lead_to_Contact_on_Pardot_Form which is PFC-update-triggered.</description>
    <environments>Default</environments>
    <interviewLabel>PFC Relink Lead to Contact on Conversion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PFC Relink Lead to Contact on Conversion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Relink_PFCs_to_Contact</name>
        <label>Relink PFCs to Contact</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <faultConnector>
            <targetReference>Log_Relink_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lead__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>$Record.ConvertedContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <object>Pardot_Form_Completion__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Relink_PFCs_to_Contact</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Log_Relink_Fault</name>
        <label>Log Relink Fault</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <flowName>PFC_Log_Fault</flowName>
        <inputAssignments>
            <name>inputContext</name>
            <value>
                <stringValue>Relink</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inputErrorDescription</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inputFlowName</name>
            <value>
                <stringValue>PFC_Relink_Lead_to_Contact_on_Conversion</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inputRecordName</name>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
