<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opp_Closed_Won_in_Days__c</fullName>
    <description>Number of days between Opportunity Created and Opportunity Closed Won</description>
    <externalId>false</externalId>
    <formula>if(ispickval(Opportunity__r.StageName, &quot;closed won&quot;), ( Opportunity_Close_Date__c - DATEVALUE(Opportunity__r.CreatedDate) ),NULL)</formula>
    <inlineHelpText>Number of days between Opportunity Created and Opportunity Closed Won</inlineHelpText>
    <label>Opp Closed Won in Days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
