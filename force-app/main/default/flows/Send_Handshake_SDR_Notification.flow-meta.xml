<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Sends the matching Sales Handshake email template to the Opportunity's Sales Development Representative team member(s) and each of their (active) managers. Invoked as a subflow from Customer_Journey for each handshake branch. Reuses the existing Classic templates by DeveloperName (portable). Skips cleanly when no SDR is on the team.</description>
    <assignments>
        <name>Asn_AddUserId</name>
        <label>Add SDR UserId</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>colSDRUserIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_OTMs.UserId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_OTMs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asn_AddSDREmail</name>
        <label>Add SDR Email</label>
        <locationX>176</locationX>
        <locationY>974</locationY>
        <assignmentItems>
            <assignToReference>colRecipientEmails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Users.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_UserHasMgr</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asn_AddMgrId</name>
        <label>Add Manager Id</label>
        <locationX>50</locationX>
        <locationY>1082</locationY>
        <assignmentItems>
            <assignToReference>colManagerIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Users.ManagerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>numManagers</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Users</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asn_AddMgrEmail</name>
        <label>Add Manager Email</label>
        <locationX>176</locationX>
        <locationY>1622</locationY>
        <assignmentItems>
            <assignToReference>colRecipientEmails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Managers.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Managers</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_HasOTMs</name>
        <label>Any SDR team members?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_OTMs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SDR_OTMs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_OTMs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_HasUsers</name>
        <label>Any active SDR users?</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_Users</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SDR_Users</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Users</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_UserHasMgr</name>
        <label>SDR has a manager?</label>
        <locationX>176</locationX>
        <locationY>1082</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Loop_Users</targetReference>
        </defaultConnector>
        <rules>
            <name>Has_Mgr</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Users.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asn_AddMgrId</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_HasManagers</name>
        <label>Any managers to resolve?</label>
        <locationX>176</locationX>
        <locationY>1298</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Send_SDR_Email</targetReference>
        </defaultConnector>
        <rules>
            <name>Has_Managers</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numManagers</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Managers</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Send_Handshake_SDR_Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Handshake SDR Notification</label>
    <loops>
        <name>Loop_OTMs</name>
        <label>Loop SDR Team Members</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_SDR_OTMs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asn_AddUserId</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_SDR_Users</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Users</name>
        <label>Loop SDR Users</label>
        <locationX>50</locationX>
        <locationY>866</locationY>
        <collectionReference>Get_SDR_Users</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asn_AddSDREmail</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_HasManagers</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Managers</name>
        <label>Loop Managers</label>
        <locationX>50</locationX>
        <locationY>1514</locationY>
        <collectionReference>Get_Managers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asn_AddMgrEmail</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_SDR_Email</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordLookups>
        <name>Get_SDR_OTMs</name>
        <label>Get SDR Team Members</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_HasOTMs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Development Representative</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityTeamMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SDR_Users</name>
        <label>Get Active SDR Users</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_HasUsers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>colSDRUserIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Managers</name>
        <label>Get Active Managers</label>
        <locationX>176</locationX>
        <locationY>1406</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Managers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>colManagerIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
