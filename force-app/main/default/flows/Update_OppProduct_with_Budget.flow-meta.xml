            </value>
        </filters>
        <filters>
            <field>Reporting_Stream__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_ReportingStream</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
