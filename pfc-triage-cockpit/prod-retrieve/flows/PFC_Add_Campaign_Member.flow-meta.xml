    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Person</targetReference>
        </connector>
        <filterFormula>AND(
NOT(ISBLANK({!$Record.Campaign__c})),
OR(NOT(ISBLANK({!$Record.Lead__c})), NOT(ISBLANK({!$Record.Contact__c}))),
OR(ISNEW(), ISCHANGED({!$Record.Campaign__c}), ISCHANGED({!$Record.Lead__c}), ISCHANGED({!$Record.Contact__c}))
)</filterFormula>
        <object>Pardot_Form_Completion__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
