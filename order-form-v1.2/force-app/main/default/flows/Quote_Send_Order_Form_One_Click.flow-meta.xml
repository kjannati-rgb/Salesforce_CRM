<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_For_Signature</name>
        <label>Send for signature</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>OrderFormSignatureService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Screen_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>OrderFormSignatureService</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Decision_Preconditions</name>
        <label>Preconditions met?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Incomplete_BG_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Status and signatory OK</defaultConnectorLabel>
        <rules>
            <name>Is_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.SBQQ__Opportunity2__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewals</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Renewal_Scope</targetReference>
            </connector>
            <label>Renewal opportunity - out of scope until 1 Jan</label>
        </rules>
        <rules>
            <name>Not_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.SBQQ__Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Not_Approved</targetReference>
            </connector>
            <label>Not approved</label>
        </rules>
        <rules>
            <name>No_Signatory</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Signatory_Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_No_Signatory</targetReference>
            </connector>
            <label>No signatory</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_BG_Complete</name>
        <label>Benefiting Group wording complete?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Quote_Document</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All BG lines defined</defaultConnectorLabel>
        <rules>
            <name>BG_Incomplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Incomplete_BG_Line</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_BG_Incomplete</targetReference>
            </connector>
            <label>BG line without a group definition</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Have_Doc</name>
        <label>Any document at all? (null-guard before template lookup)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Document</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No document</defaultConnectorLabel>
        <rules>
            <name>Have_Doc</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Document</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Document_Exists</targetReference>
            </connector>
            <label>Document exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Document_Exists</name>
        <label>Quote document exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Document</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No document</defaultConnectorLabel>
        <rules>
            <name>Wrong_Template</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Document</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Document.SBQQ__Template__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Subscription Order Form</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Wrong_Template</targetReference>
            </connector>
            <label>Latest document is not the Subscription Order Form</label>
        </rules>
        <rules>
            <name>Document_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Document</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_For_Signature</targetReference>
            </connector>
            <label>Document found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Quote - Send Order Form (One Click) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Send Order Form (One Click)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Preconditions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SBQQ__Quote__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Incomplete_BG_Line</name>
        <label>Get a Benefiting Group line without wording</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_BG_Complete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>License_Model__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Benefiting Group</stringValue>
            </value>
        </filters>
        <filters>
            <field>Benefiting_Group_Description__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Function_Name__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Benefitting_Group__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Quote_Document</name>
        <label>Get latest quote document</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Have_Doc</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SBQQ__QuoteDocument__c</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_Renewal_Scope</name>
        <label>Renewals join on 1 January</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>RenewalScopeText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;The Order Form covers new business for now.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;This quote belongs to a renewal opportunity. Renewals continue on the current process and move to the Order Form on &lt;b&gt;1 January 2027&lt;/b&gt;. Nothing has been sent.&lt;/p&gt;&lt;p&gt;If this deal genuinely needs the Order Form sooner, contact the CRM team.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Not_Approved</name>
        <label>Quote not approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NotApprovedText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;This quote is not Approved.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Current status: {!Get_Quote.SBQQ__Status__c}. The Order Form can only be sent for signature once approval is complete.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
