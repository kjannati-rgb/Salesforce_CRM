    <description>REV-57/REV-77: single consolidated PFC after-save flow. Controlled order: (1) Stamp Name/Account/Campaign (absorbs legacy On_Pardot_Form_Creation), (2) cross-link same person+brand open PFCs, (3) add Campaign Member (Registered). Replaces On_Pardot_Form_Creation + PFC_Check_And_Link + PFC_Add_Campaign_Member. Fail-open via PFC_Log_Fault.</description>
    <environments>Default</environments>
    <formulas>
        <name>brandToMatch</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK(TEXT({!$Record.Product_Brand__c}))), TEXT({!$Record.Product_Brand__c}), {!$Record.Brand__c})</expression>
    </formulas>
    <formulas>
        <name>campaignForMember</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!resolvedCampaignId})), {!resolvedCampaignId}, {!$Record.Campaign__c})</expression>
    </formulas>
    <formulas>
        <name>ContactAccount</name>
        <dataType>String</dataType>
        <expression>{!$Record.Contact__r.Account.Id}</expression>
    </formulas>
    <formulas>
        <name>FormName2</name>
        <dataType>String</dataType>
        <expression>LEFT(({!$Record.Prospect_Name__c} &amp; &quot; | &quot; &amp; TEXT({!$Record.Form_Name__c})), 80)</expression>
    </formulas>
    <formulas>
        <name>productBrandToStamp</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.Product_Brand__c})), {!$Record.Brand__c}, TEXT({!$Record.Product_Brand__c}))</expression>
    </formulas>
