<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>SBQQ__PaymentTerms__c</field>
        <field>Payment_Type__c</field>
        <field>SBQQ__AverageCustomerDiscount__c</field>
        <field>SBQQ__NetAmount__c</field>
        <field>Special_Terms__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>The Sales Manager field is the Manager field found on the Quote Owner user record.</description>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.SBQQ__AverageCustomerDiscount__c</field>
                <operation>greaterThan</operation>
                <value>10</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Sales Manager: 10% - 20% Discount</label>
        <name>Sales_Manager_10_20_Discount</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>edward.costelloe@lbresearch.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>There is no Head of Sales, so the approval jumps straight to the Sales Director.</description>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.SBQQ__AverageCustomerDiscount__c</field>
                <operation>greaterThan</operation>
                <value>20</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Sales Director: 20% - 40% Discount</label>
        <name>Sales_Director_20_40_Discount</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>george.mcferran@lbresearch.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This step is for the Divisional MD.</description>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.SBQQ__AverageCustomerDiscount__c</field>
                <operation>greaterThan</operation>
                <value>40</value>
            </criteriaItems>
        </entryCriteria>
        <label>Divisional MD: 40% Plus Discount</label>
        <name>Divisional_MD_40_Plus_Discount</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>This discount approval is specific to the UK New Business Lexology Inform team.</description>
    <emailTemplate>SA_Quote_Email_Templates/Quote_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__AverageCustomerDiscount__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Type__c</field>
            <operation>equals</operation>
            <value>Quote</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.LBR_Legal_Entity__c</field>
            <operation>equals</operation>
            <value>Law Business Research (UK) Ltd.</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Team__c</field>
            <operation>equals</operation>
            <value>Lex Inform</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Discount_Approval_Message</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Discount_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_Approved_Record_Type</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_Status_Approve</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_Watermark_False</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Discount_Rejection_Message</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Discount_Status_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>In_Review</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Discount Lexology Inform NB UK</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>5</processOrder>
    <recallActions>
        <action>
            <name>Discount_Recall_Message</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Discount_Status_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
