    <description>This flow updates the fields of triggering record, record can be new or existing. Most generic fields are updated in this flow</description>
    <environments>Default</environments>
    <formulas>
        <name>Budget_renewal_date</name>
        <dataType>Date</dataType>
        <expression>{!recordId.SBQQ__RenewedContract__r.EndDate} + 1</expression>
    </formulas>
    <formulas>
        <name>downsell</name>
        <dataType>Number</dataType>
        <expression>IF({!recordId.Renewed_CACV__c} - {!recordId.Renewed_PACV__c} &lt;0, {!recordId.Renewed_CACV__c} - {!recordId.Renewed_PACV__c} , 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Forecast_status</name>
        <dataType>String</dataType>
        <expression>if(text({!recordId.Owner.Team__c})=&apos;Lexology Pro&apos; || text({!recordId.Owner.Team__c})=&apos;Specialist Platforms&apos;  || text({!recordId.Owner.Team__c})=&apos;Lexology Intelligence&apos; ,&apos;Forecast Pending&apos;,&apos;Forecast Won&apos;)</expression>
    </formulas>
    <formulas>
        <name>forecastvalue</name>
        <dataType>String</dataType>
        <expression>CASE({!recordId.Type},
&quot;New Business&quot;, &quot;New Business&quot;, 
&quot;Auto-Renewal&quot;, &quot;Renewal&quot;, 
&quot;Auto-Repeat Business&quot;, &quot;Renewal&quot;, 
&quot;Renewal&quot;, &quot;Renewal&quot;, 
&quot;Repeat Business&quot;, &quot;Renewal&quot;, 
&quot;Upsell&quot;, &quot;Upsell&quot;, 
&quot;Downgrade&quot;, &quot;Downgrade&quot;, 
&quot;Cancellation&quot;, &quot;Cancellation&quot;, 
null)</expression>
    </formulas>
    <formulas>
        <name>isAmended</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!recordId.SBQQ__AmendedContract__c}))</expression>
    </formulas>
    <formulas>
        <name>isCancelled</name>
        <dataType>Boolean</dataType>
        <expression>if(
{!recordId.Cancelled__c} = true,true,false
)</expression>
    </formulas>
    <formulas>
        <name>Next_contact_date</name>
        <dataType>Date</dataType>
        <expression>{!recordId.SBQQ__RenewedContract__r.EndDate} -90</expression>
    </formulas>
    <formulas>
        <name>percentannualuplift</name>
        <dataType>Number</dataType>
        <expression>((({!recordId.Annual_Contract_Value_converted__c}/{!recordId.Previous_Annual_Contract_Value__c})-1)) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Target_renewal_date</name>
        <dataType>Date</dataType>
        <expression>{!recordId.SBQQ__RenewedContract__r.EndDate} -90</expression>
    </formulas>
    <formulas>
        <name>upsell</name>
        <dataType>Number</dataType>
        <expression>IF({!recordId.Renewed_CACV__c} - {!recordId.Renewed_PACV__c} &gt;0, {!recordId.Renewed_CACV__c} - {!recordId.Renewed_PACV__c} , 0)</expression>
        <scale>2</scale>
    </formulas>
