<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_PACV__c</fullName>
    <description>Previous Annual Contract Value cancelled</description>
    <externalId>false</externalId>
    <formula>IF (
AND(RecordType.DeveloperName = &quot;Renewals&quot;,
TEXT(StageName) = &quot;Closed Lost&quot;), Previous_Annual_Contract_Value__c , 0)
*
-1</formula>
    <inlineHelpText>Previous Annual Contract Value cancelled</inlineHelpText>
    <label>Cancelled PACV</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
