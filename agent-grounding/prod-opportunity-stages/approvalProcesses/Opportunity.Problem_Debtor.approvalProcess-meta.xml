<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StageName</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>bernadette.osullivan@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>chloe.orrin@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>kevin.daud@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>nadia.hassan@lbresearch.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>zzz_327ae040-e87e-419e-b2a0-2889bf632990@deleted.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Problem Debtor Approval</label>
        <name>Problem_Debtor_Approval</name>
    </approvalStep>
    <emailTemplate>SA_Opportunity_Email_Templates/Opportunity_Approval_Process</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(NOT( $Setup.Application_Settings__c.Disable_Approval_Processes__c ),
NOT(Approved__c),
NOT(Submitted_to_Approval_Process__c),
ISPICKVAL( StageName , &apos;Closed won – pending approval&apos;),
ISPICKVAL(Account.Debtor_Status__c , &quot;Problem Debtor&quot;)
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Finance_Submitted_to_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Approved_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Ordered</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stage_Closed_Won</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opportunity_Approved_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejected_Submitted_for_Approval_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejection_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Stage_Contract_Out</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Problem Debtor</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Opportunity_Recall_email_notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Recall_Opportunity_Approved_False</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recall_Stage_Contract_Out</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recall_Submitted_for_Approval_False</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
