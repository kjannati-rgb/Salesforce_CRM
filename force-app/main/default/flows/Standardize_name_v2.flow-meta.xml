    <formulas>
        <name>var_NameDocketNavigator</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!var_TotalRecords} &gt; 1,
        OR(
            TEXT({!$Record.Type}) = &apos;Renewal&apos;,
            TEXT({!$Record.Type}) = &apos;Auto-Renewal&apos;
        )
    ),
    LEFT(
        &quot;Docket Navigator - Multi Product | &quot; &amp; TEXT({!$Record.Type}) &amp; &quot; | &quot; &amp; {!$Record.Budget_Renewal_Month__c} &amp; &quot; | &quot; &amp; TEXT({!$Record.Current_Deal_Length__c}) &amp; &quot; Month(s) | &quot; &amp; TEXT({!$Record.CurrencyIsoCode}) &amp; &quot; | &quot; &amp; TEXT({!$Record.Amount}) &amp; &quot; | &quot; &amp; {!$Record.Account.Name} &amp; &quot; | &quot; &amp; {!$Record.Primary_Contact__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Primary_Contact__r.LastName},
        120
    ),
    IF(
        AND(
            {!var_TotalRecords} &gt; 1,
            NOT(
                OR(
                    TEXT({!$Record.Type}) = &apos;Renewal&apos;,
                    TEXT({!$Record.Type}) = &apos;Auto-Renewal&apos;
                )
            )
        ),
        LEFT(
            &quot;Docket Navigator - Multi Product | &quot; &amp; TEXT({!$Record.Type}) &amp; &quot; | &quot; &amp; TEXT({!$Record.Current_Deal_Length__c}) &amp; &quot; Month(s) | &quot; &amp; TEXT({!$Record.CurrencyIsoCode}) &amp; &quot; | &quot; &amp; TEXT({!$Record.Amount}) &amp; &quot; | &quot; &amp; {!$Record.Account.Name} &amp; &quot; | &quot; &amp; {!$Record.Primary_Contact__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Primary_Contact__r.LastName},
            120
        ),
        IF(
            NOT(
                OR(
                    TEXT({!$Record.Type}) = &apos;Renewal&apos;,
                    TEXT({!$Record.Type}) = &apos;Auto-Renewal&apos;
                )
            ),
            LEFT(
                {!var_productname} &amp; &quot; | &quot; &amp; TEXT({!$Record.Type}) &amp; &quot; | &quot; &amp; TEXT({!$Record.Current_Deal_Length__c}) &amp; &quot; Month(s) | &quot; &amp; TEXT({!var_QLquantity}) &amp; &quot; Users | &quot; &amp; TEXT({!$Record.CurrencyIsoCode}) &amp; &quot; | &quot; &amp; TEXT({!$Record.Amount}) &amp; &quot; | &quot; &amp; {!$Record.Account.Name} &amp; &quot; | &quot; &amp; {!$Record.Primary_Contact__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Primary_Contact__r.LastName},
