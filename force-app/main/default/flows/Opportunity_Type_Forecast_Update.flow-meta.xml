    <decisions>
        <name>Checking_Condition</name>
        <label>Checking Condition</label>
        <locationX>248</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Create_Flow_Log_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Disable_Processes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckDisableProcesses</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Check Disable Processes</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision is used to create a path to ultimately update the  Opportunity Type (Forecast) field!</description>
        <name>Which_Opportunity_Type</name>
        <label>Which Opportunity Type?</label>
        <locationX>710</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Business</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Business</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Type_Forecast_New_Business</targetReference>
            </connector>
            <label>New Business</label>
        </rules>
        <rules>
            <name>Renewal</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto-Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Repeat Business</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Type_Forecast_Renewal</targetReference>
            </connector>
            <label>Renewal</label>
        </rules>
        <rules>
            <name>Upsell_Upgrade</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Upsell</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Type_Forecast_Upsell_Upgrade</targetReference>
            </connector>
            <label>Upsell/Upgrade</label>
        </rules>
        <rules>
            <name>Downsell_Downgrade</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Downgrade</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Type_Forecast_Downsell_Downgrade</targetReference>
            </connector>
            <label>Downsell/Downgrade</label>
        </rules>
        <rules>
            <name>Cancellation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Type_Forecast_Cancellation</targetReference>
            </connector>
            <label>Cancellation</label>
        </rules>
    </decisions>
    <description>This Flow is used to Group the Type field into groupings i.e. Renewal, Auto-Renewal, and Repeat Business into Renewals! It is used in Salesforce standard forecasting!</description>
