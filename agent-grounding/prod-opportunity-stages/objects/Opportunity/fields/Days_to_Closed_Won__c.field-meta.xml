<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_to_Closed_Won__c</fullName>
    <description>This field calculates the number of days it took for the opportunity to close as won since its creation.</description>
    <externalId>false</externalId>
    <formula>if(text(StageName)= &quot;Closed Won&quot;,  CloseDate - DATEVALUE(CreatedDate),0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days to Closed Won</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
