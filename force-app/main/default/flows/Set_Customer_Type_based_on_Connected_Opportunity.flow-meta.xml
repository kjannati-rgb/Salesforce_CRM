    <decisions>
        <name>Check_if_there_is_a_connected_Opportunity</name>
        <label>Check if there is a connected Opportunity</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Set_Customer_Type_to_Paid</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Connected_opportunity_doesn_t_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Connected_opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Customer_Type_to_Free</targetReference>
            </connector>
            <label>Connected opportunity exists</label>
        </rules>
    </decisions>
    <description>If a connected Opportunity exists the Type is set to Paid and if it does not the Type is set to Free</description>
