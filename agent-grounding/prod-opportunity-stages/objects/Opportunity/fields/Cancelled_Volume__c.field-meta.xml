<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_Volume__c</fullName>
    <description>The volume of Renewal Opportunities Closed Lost</description>
    <externalId>false</externalId>
    <formula>IF (
AND(RecordType.DeveloperName = &quot;Renewals&quot;,
TEXT( StageName) = &quot;Closed Lost&quot;), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>The volume of Renewal Opportunities Closed Lost</inlineHelpText>
    <label>Cancelled Volume</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
