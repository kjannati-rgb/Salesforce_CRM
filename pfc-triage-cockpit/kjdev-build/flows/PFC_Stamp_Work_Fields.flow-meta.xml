        <locationX>176</locationX>
        <locationY>640</locationY>
        <defaultConnector>
            <targetReference>Decision_Clear_Overdue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No stamp</defaultConnectorLabel>
        <rules>
            <name>ClosedAndUnstamped</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Date_Completed__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sales_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Converted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sales_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Disqualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Date_Completed</targetReference>
            </connector>
            <label>Closed, not yet stamped</label>
        </rules>
    </decisions>
