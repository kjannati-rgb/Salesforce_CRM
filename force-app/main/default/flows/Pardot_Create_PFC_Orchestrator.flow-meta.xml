    <description>REV-57 unified orchestrator. On Pardot-created Task (NF -/PFC:/Lead scoring MQL/EVT), resolves the PFC_Task_Mapping__mdt row by left-anchored prefix, creates the Pardot Form Completion (RT by DeveloperName, source, brand, parsed form name), then links WhoId to Lead__c/Contact__c via a separate update (so On_Pardot_Form_Creation + PFC_Check_And_Link fire). Replaces Create_Pardot_Form_from_Task at cutover. Assignment is left to Clay (Clay_Routed__c=false).</description>
    <environments>Default</environments>
    <formulas>
        <name>monthYear</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH({!$Flow.CurrentDate}),
1, &quot;January&quot;, 2, &quot;February&quot;, 3, &quot;March&quot;, 4, &quot;April&quot;, 5, &quot;May&quot;, 6, &quot;June&quot;,
7, &quot;July&quot;, 8, &quot;August&quot;, 9, &quot;September&quot;, 10, &quot;October&quot;, 11, &quot;November&quot;, 12, &quot;December&quot;, &quot;&quot;)
&amp; &quot; &quot; &amp; TEXT(YEAR({!$Flow.CurrentDate}))</expression>
    </formulas>
    <formulas>
        <name>formFromSubject</name>
        <dataType>String</dataType>
        <expression>IF({!matchParseFormName} = false,
IF(ISBLANK({!matchDefaultFormName}), &quot;&quot;,
{!matchDefaultFormName} &amp; &quot; - &quot; &amp; {!monthYear} &amp; IF(ISBLANK({!matchSuffix}), &quot;&quot;, &quot; - &quot; &amp; {!matchSuffix})),
IF(BEGINS({!$Record.Subject}, {!matchStripPrefix}),
MID({!$Record.Subject}, LEN({!matchStripPrefix}) + 1, LEN({!$Record.Subject})),
{!$Record.Subject}))</expression>
    </formulas>
    <formulas>
        <name>isPrefixMatch</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.Subject}, {!Loop_Mappings.Subject_Prefix__c})</expression>
    </formulas>
