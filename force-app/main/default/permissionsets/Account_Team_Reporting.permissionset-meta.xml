<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Account Team Reporting</label>
    <description>Read-only FLS on the Account CSM mirror fields and the Account Team Change audit object, for reports/dashboards. No team-management capability (no Manage Account CSMs, no controller). Assign to the DPO, CS leadership, and report consumers.</description>
