    <recordLookups>
        <name>Get_Member_Contact</name>
        <label>Existing Contact Member?</label>
        <locationX>88</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_NoMember_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
