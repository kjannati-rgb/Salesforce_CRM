<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Weighted_Next_Month__c</fullName>
    <description>In this field we calculate weighted amount of the opp if close date in in NEXT MONTH</description>
    <formula>IF(
MONTH( CloseDate ) = MONTH(TODAY()+30),
 Weighted_Amount__c ,
0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Weighted Next Month</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
